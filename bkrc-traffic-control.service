[Unit]
Description=BKRC traffic sign and chassis WebUI
After=multi-user.target

[Service]
Type=simple
User=bkrc
SupplementaryGroups=video dialout
WorkingDirectory=/home/bkrc/traffic_sign_control
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/bkrc/traffic_sign_control/run.py --camera 0 --port /dev/ttyACM0 --web --traffic-control --speed 100 --traffic-model /home/bkrc/traffic_sign_control/models/best_deploy.onnx --web-host 127.0.0.1 --web-port 9090
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
